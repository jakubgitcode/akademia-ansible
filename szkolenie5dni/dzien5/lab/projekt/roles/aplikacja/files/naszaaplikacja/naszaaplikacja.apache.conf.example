<VirtualHost *:5081>
    ServerName naszaaplikacja.szkolenie.pl
    ErrorLog /var/www/szkolenie.pl/logs/error.log
    CustomLog /var/www/szkolenie.pl/logs/access.log combined

    WSGIDaemonProcess naszaaplikacja user=www-data group=www-data threads=5 python-home=/var/www/szkolenie.pl/aplikacja/venv
    WSGIProcessGroup naszaaplikacja
    WSGIScriptAlias / /var/www/szkolenie.pl/aplikacja/naszaaplikacja.wsgi

    <Directory /var/www/szkolenie.pl/aplikacja>
        Require all granted
    </Directory>
</VirtualHost>
